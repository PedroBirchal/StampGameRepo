; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="StampGame"
run/main_scene="uid://di6ne7kiyjw8c"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Singleton="*uid://c7obwei6oy624"
AudioManager="*uid://bvaff8scei3ag"
DialogManager="*uid://bh3y4ynh43gnk"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[file_customization]

folder_colors={
"res://Blend/": "red",
"res://Fonts/": "orange",
"res://Models/": "green",
"res://Scenes/": "blue",
"res://Scripts/": "purple",
"res://Sounds/": "red",
"res://Sprites/": "pink",
"res://addons/": "gray",
"res://materials/": "yellow",
"res://resources/": "teal"
}

[filesystem]

import/blender/enabled=false

[global_group]

sumivel="Objetos que ao se aproximar da camera podem ou não sumir (diferente dos outros que por padrão não somem). Colocar em MeshInstance3D apenas!"
costas_quarto=""
direita_quarto=""
esquerda_quarto=""
frente_quarto=""

