[resource]
script = ExtResource("1_l6ak2")
conteudo = "Querido irmão,
 O desgosto no resto de nossa mãe ao ver que na sua casa agora abriga um ser de fogo. Você sabe o quanto ela lutou e se esforçou por você, seu ingrato? Volte a sua consciência e volte para casa. Arrependa-se de uma vez. Ou enfrente as consequências.
 Atenciosamente, Aguado Aquoso"
