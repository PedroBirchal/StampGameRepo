[resource]
script = ExtResource("1_37wsh")
conteudo = "Prezado senhora satania,
 Espero que essa carta o encontre bem. Tenho o prazer de anunciar sua tão aguardada aprovação na Universidade de Torres. Compareça no Campus até 33 de Dozembro, com a seguinte Documentação:
- Carteira Identitadária
- Compravação de conclusão de escolinha
- Aprovação parental
- Um chocolatinho (Entregar para Seu Madrugada)

Estamos ansiosos para vê-lo conosco pelos próximos quatro anos.

Atenciosamente,
Universidade Estadual de Torres."
vindo_de = 3
indo_para = 2
