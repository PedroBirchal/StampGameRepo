[ext_resource type="PackedScene" uid="uid://cvyw2wtxjq15y" path="res://Models/Carta.fbx" id="1_w3f0s"]

[sub_resource type="GDScript" id="GDScript_5s6cr"]
script/source = "extends Window

@export var animacao: AnimationPlayer
@export var meio: Node3D
@export var final: Node3D
@export var botao: Control

var main_menu

signal sumindo
signal sumiu

func aparecer() -> void:
	visible = true
	animacao.play(\"girando_idle\")
	grab_focus()

func sumir() -> void:
	visible = false
	sumiu.emit()
	queue_free()
	pass

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	visible = false
	#var main_window: Window = get_parent()
	#main_window.mode = Window.MODE_MINIMIZED
	#main_window.unfocusable = true
	
	#main_menu = ResourceLoader.load_threaded_request(\"res://Scenes/MainMenu.tscn\")
	pass

func dar_play() -> void:
	var rot = meio.rotation
	animacao.stop()
	meio.rotation = rot
	botao.hide()
	
	meio.reparent(final)
	var tween = get_tree().create_tween().set_parallel()
	tween.tween_property(meio, \"position\", Vector3.ZERO, 3.0)
	tween.tween_property(meio, \"rotation\", Vector3.ZERO, 2.5)
	
	await tween.finished
	
	sumindo.emit()
	grab_focus()
	
	var open = AudioManager.open_letter
	open.play()
	
	await open.finished
	#var timer = get_tree().create_timer(5.0)
	#var main_window: Window = get_parent()
	#main_window.unfocusable = false
	#main_window.mode = Window.MODE_FULLSCREEN
	#
	#get_tree().change_scene_to_file(\"res://Scenes/MainMenu.tscn\")
	sumir()
	
	#meio.hide()
	
"

