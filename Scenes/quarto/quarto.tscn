[sub_resource type="GDScript" id="GDScript_bjlr0"]
script/source = "extends Jogavel

@export var camera: Camera3D

func jogar() -> void:
	super()
	camera.make_current()

func sair() -> void:
	super()
	camera.clear_current()
"

